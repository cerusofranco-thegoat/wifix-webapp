<?xml version="1.0" encoding="utf-8"?>
<!--
  Permite HTTP cleartext en desarrollo para que el APK pueda hablar con el
  backend local del técnico (laptop en la misma LAN). En producción esto debe
  restringirse al dominio HTTPS real del servidor de Wifix.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
