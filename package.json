{
  "name": "wifix-webapp",
  "version": "0.2.0",
  "private": true,
  "description": "Wifix Certificate — webapp móvil + shell Capacitor Android con herramientas de red nativas.",
  "scripts": {
    "build:web": "node scripts/build-www.mjs",
    "serve": "npx http-server . -p 5173 -c-1",
    "smoke": "node scripts/smoke-ui.mjs",
    "cap:sync": "npm run build:web && cap sync android",
    "cap:open": "cap open android",
    "cap:run": "npm run build:web && cap run android"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "jimp": "^1.6.1"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^6.2.0",
    "@capacitor/android": "^6.1.2",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/core": "^6.1.2",
    "@capacitor/device": "^6.0.1",
    "@capacitor/geolocation": "^6.1.1",
    "@capacitor/network": "^6.0.3",
    "@pantrist/capacitor-plugin-ml-kit-text-recognition": "^6.2.1"
  }
}
